[Unit]
Description=RTASE PRU0 firmware loader
After=local-fs.target systemd-modules-load.service
ConditionPathExists=/lib/firmware/am335x-pru0-rtase.out

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rtase-pru-service start
ExecStop=/usr/local/sbin/rtase-pru-service stop
RemainAfterExit=yes
TimeoutStartSec=125
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
