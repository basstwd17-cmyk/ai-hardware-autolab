BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# BBB PRU1 -> MachXO2 inputs
LOCATE COMP "sel0" SITE "35";
IOBUF PORT "sel0" IO_TYPE=LVCMOS33;
LOCATE COMP "sel1" SITE "34";
IOBUF PORT "sel1" IO_TYPE=LVCMOS33;

# Debug header outputs (physical pin 116 is ground and is intentionally unused)
LOCATE COMP "dbg0" SITE "117";
IOBUF PORT "dbg0" IO_TYPE=LVCMOS33;
LOCATE COMP "dbg1" SITE "121";
IOBUF PORT "dbg1" IO_TYPE=LVCMOS33;
LOCATE COMP "dbg_xor" SITE "122";
IOBUF PORT "dbg_xor" IO_TYPE=LVCMOS33;
