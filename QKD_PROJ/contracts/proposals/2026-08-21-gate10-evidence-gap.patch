+    than deleted because they are what was observed; they are no longer
+    evidence, and this block may not be cited as a passing gate.
+  reinstatement_requires:
+    - An approved re-run of the GPIO0_3 clocked-return read under this contract.
+    - A RunRecord for that run, with the received frame in its measurements.
+    - Replacing verdict with PASS only after the reduction reports satisfied.
   overlay: BB-RTASE-A-GPIO-SPI-00A0.dtbo
   pinmux:
     P9_17_CS: {gpio: GPIO0_5, padconf: 0x07, direction: output}
@@ -138,13 +151,42 @@ gpio_spi_fallback_result:
     P9_21_MISO: {gpio: GPIO0_3, padconf: 0x27, direction: input}
     P9_22_SCLK: {gpio: GPIO0_2, padconf: 0x07, direction: output}
   expected_rx: a55a3cc3f00f
