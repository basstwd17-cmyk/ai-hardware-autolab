@@ -1,6 +1,6 @@
 schema_version: 1
 test_id: gate10-spi-clocked-return
-status: gpio_spi_fallback_verified_mcspi_rx_fault_isolated
+status: gpio_spi_fallback_evidence_gap_mcspi_rx_fault_isolated_by_scope
 
 purpose:
   - Verify BBB mode-0 MISO sampling using data launched by the CPLD on SCLK falling edges.
@@ -130,7 +130,20 @@ sram_program_candidate:
   immutable: true
 
 gpio_spi_fallback_result:
+  verdict: WARNING_evidence_gap
+  evidence_status: primary_run_missing
   run: 20260820T063111Z_gate10_gpio0_3_clocked_return
+  run_presence: absent
+  evidence_note: >-
+    The run named above is not on disk. The values recorded in this block were
