# BBB PRU0 selection and update inputs on RTASE_V1 channel A.
LOCATE COMP "sym_a0" SITE "85";
IOBUF PORT "sym_a0" IO_TYPE=LVCMOS33;
LOCATE COMP "sym_a1" SITE "84";
IOBUF PORT "sym_a1" IO_TYPE=LVCMOS33;
LOCATE COMP "ldac_a" SITE "35";
IOBUF PORT "ldac_a" IO_TYPE=LVCMOS33;

# AD9744 U6 parallel data bus D1B[13:0].  Data edges are deliberately slow.
LOCATE COMP "d1b[0]" SITE "56";
LOCATE COMP "d1b[1]" SITE "57";
LOCATE COMP "d1b[2]" SITE "58";
LOCATE COMP "d1b[3]" SITE "59";
LOCATE COMP "d1b[4]" SITE "60";
LOCATE COMP "d1b[5]" SITE "61";
LOCATE COMP "d1b[6]" SITE "62";
LOCATE COMP "d1b[7]" SITE "63";
LOCATE COMP "d1b[8]" SITE "65";
LOCATE COMP "d1b[9]" SITE "67";
LOCATE COMP "d1b[10]" SITE "68";
LOCATE COMP "d1b[11]" SITE "69";
LOCATE COMP "d1b[12]" SITE "70";
LOCATE COMP "d1b[13]" SITE "71";
IOBUF PORT "d1b[0]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[1]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[2]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[3]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[4]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[5]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[6]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[7]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[8]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[9]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[10]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[11]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[12]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
IOBUF PORT "d1b[13]" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

# AD9744 U6 CLOCK.  A fast edge is used even though the demonstration rate is
# low; the 20 ns default pulse is generated by the PRU.
LOCATE COMP "d1clk" SITE "73";
IOBUF PORT "d1clk" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST;
