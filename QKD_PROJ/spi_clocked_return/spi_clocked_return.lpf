# BBB SPI0 clock/chip-select inputs and the sole diagnostic return output.
LOCATE COMP "spi_cs_n" SITE "32";
IOBUF PORT "spi_cs_n" IO_TYPE=LVCMOS33;
LOCATE COMP "spi_miso" SITE "33";
IOBUF PORT "spi_miso" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "spi_sclk" SITE "34";
IOBUF PORT "spi_sclk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "spi_sclk" 10.000000 MHz;
