# BBB SPI0 inputs and MISO return.
LOCATE COMP "spi_mosi" SITE "31";
IOBUF PORT "spi_mosi" IO_TYPE=LVCMOS33;
LOCATE COMP "spi_cs_n" SITE "32";
IOBUF PORT "spi_cs_n" IO_TYPE=LVCMOS33;
LOCATE COMP "spi_miso" SITE "33";
IOBUF PORT "spi_miso" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "spi_sclk" SITE "34";
IOBUF PORT "spi_sclk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "spi_sclk" 10.000000 MHz;

# Latched diagnostics returned to BBB GPIO inputs.
LOCATE COMP "alive" SITE "78";
IOBUF PORT "alive" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "cs_seen" SITE "83";
IOBUF PORT "cs_seen" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "sclk_seen" SITE "82";
IOBUF PORT "sclk_seen" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "frame_done" SITE "81";
IOBUF PORT "frame_done" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
LOCATE COMP "write_done" SITE "28";
IOBUF PORT "write_done" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
